{
  "name": "watchtower",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "dev:prod": "vite --mode production",
    "build": "tsc && vite build",
    "build:staging": "tsc && vite build --mode staging",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:staging": "cross-env NODE_ENV=staging tauri dev --config \"{\\\"build\\\": {\\\"beforeDevCommand\\\": \\\"pnpm dev:staging\\\"}}\"",
    "tauri:dev:prod": "cross-env NODE_ENV=production tauri dev --config \"{\\\"build\\\": {\\\"beforeDevCommand\\\": \\\"pnpm dev:prod\\\"}}\"",
    "tauri:build": "dotenv -e .env.build -- tauri build",
    "tauri:build:staging": "dotenv -e .env.build -- cross-env NODE_ENV=staging tauri build --config \"{\\\"build\\\": {\\\"beforeBuildCommand\\\": \\\"pnpm build:staging\\\", \\\"frontendDist\\\": \\\"../watchtower-staging\\\"}}\"",
    "tauri:build:prod": "dotenv -e .env.build -- cross-env NODE_ENV=production tauri build --config \"{\\\"build\\\": {\\\"beforeBuildCommand\\\": \\\"pnpm build:prod\\\", \\\"frontendDist\\\": \\\"../watchtower-prod\\\"}}\"",
    "tauri:build:staging:upload": "pnpm tauri:build:staging && dotenv -e .env.build -- cross-env NODE_ENV=staging node scripts/upload-release.mjs $1",
    "tauri:build:prod:upload": "pnpm tauri:build:prod && dotenv -e .env.build -- cross-env NODE_ENV=production node scripts/upload-release.mjs $1",
    "tauri:build:upload": "dotenv -e .env.build -- tauri build && node scripts/upload-release.mjs $1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "axios": "^1.13.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1003.0",
    "@aws-sdk/lib-storage": "^3.1003.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "globby": "^16.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
